# Copy this file to .env.local and fill in your Supabase project credentials.
# Create a free Supabase project, run db/schema.sql in its SQL editor, then
# optionally seed data with: npm run seed

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-side admin access (used nowhere at runtime currently)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key