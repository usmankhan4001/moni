# Moni Environment Configuration

# Database Connection (Native PostgreSQL 16)
DATABASE_URL=postgres://moni_user:moni_password@localhost:5432/moni_db

# Used by docker-compose.yml to configure the bundled Postgres container.
# Required — docker-compose will refuse to start without a real password set.
POSTGRES_USER=moni_user
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=moni_db

# Deployment Mode: single_user OR multi_tenant
# single_user: zero auth, one auto-provisioned workspace. Safe default.
# multi_tenant: requires signup/login (see AUTH_SECRET below) — every
# workspace's data is isolated behind a verified session, never a
# client-supplied header/cookie.
DEPLOYMENT_MODE=single_user

# Required whenever DEPLOYMENT_MODE=multi_tenant. Signs session cookies —
# treat it like a password; rotating it logs everyone out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Optional. Comma-separated, case-insensitive list of emails allowed to view
# the read-only /admin tenant list in multi_tenant mode. Leave empty to
# disable /admin entirely.
ADMIN_EMAILS=

# Cloudflare R2 Free Tier Storage Credentials (S3-Compatible)
# Backups are disabled until both this section AND BACKUP_ENCRYPTION_KEY
# below are set.
R2_ACCOUNT_ID=your-cloudflare-r2-account-id
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET_NAME=moni-backups

# Required to enable backups at all — snapshots are AES-256-GCM encrypted
# before upload using this key. Must decode to exactly 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=

# Shared secret that authorizes the docker-compose `backup-cron` sidecar (or
# any external scheduler, e.g. Dokploy's own cron, cron-job.org) to call
# POST /api/cron/backup and trigger the daily automated backup run.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
CRON_SECRET=

# Dokploy Server / Cloudflare Wildcard Tunnel Configuration
# Host header forwarding is enabled by default in Cloudflare Tunnels (*.yourdomain.com)

# The apex domain Moni is served from — no scheme, no trailing slash, no
# wildcard (e.g. moni.example.com). docker-compose.yml builds its Traefik Host
# rule from this, matching both the apex and every `*.` subdomain under it.
# If this doesn't match the host in the browser's address bar, Traefik has no
# router for the request and answers `404 page not found`.
MONI_DOMAIN=yourdomain.com
